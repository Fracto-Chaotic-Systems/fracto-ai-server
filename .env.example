# Native service configuration. Model selection does not download a model.
FRACTO_AI_ENGINE=ollama
FRACTO_OLLAMA_URL=http://127.0.0.1:11434
FRACTO_OLLAMA_ALLOW_HOST_GATEWAY=false
FRACTO_AI_MODEL=
# Native defaults: protected runtime/inference store and loopback listener.
FRACTO_AI_LISTEN_HOST=127.0.0.1
FRACTO_AI_MIN_FREE_MEMORY_MIB=6144
FRACTO_AI_MIN_FREE_DISK_MIB=1024
# Separate peer TLS listener. Identity and empty trust initialize automatically.
FRACTO_AI_PEERS_ENABLED=true
FRACTO_AI_PEER_LISTEN_HOST=127.0.0.1
FRACTO_AI_PEER_PORT=3447
# FRACTO_AI_PEER_DATA_DIR defaults to <FRACTO_AI_DATA_DIR>/peers when set,
# otherwise runtime/peers. Keep this dedicated credential directory private.
# FRACTO_AI_DATA_DIR selects a dedicated local store, never a network share.
# A machine token is generated automatically in that store; do not commit it.
# Save as .env for automatic loading by npm start/dev and the root service launcher.
# Inherited environment values take precedence; direct Node needs --env-file=.env.
# Docker Compose passes the equivalent non-secret deployment settings.
