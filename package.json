{
  "name": "fracto-ai-server",
  "version": "0.1.0",
  "description": "Fracto AI and operations service foundation",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "construction:evaluate": "node --env-file-if-exists=.env scripts/evaluate_construction.js",
    "construction:plan": "node --env-file-if-exists=.env scripts/plan_construction.js",
    "start": "node --env-file-if-exists=.env index.js",
    "dev": "node --env-file-if-exists=.env --watch index.js",
    "check": "node check_syntax.js && node --test --test-concurrency=2",
    "test": "node --test --test-concurrency=2"
  },
  "dependencies": {
    "@peculiar/x509": "3.1.0",
    "ajv": "8.20.0",
    "express": "^5.2.1",
    "reflect-metadata": "0.2.2",
    "@fracto/sdk": "file:../../sdk"
  },
  "fracto": {
    "commands": {
      "evaluate_construction": "scripts/evaluate_construction.js",
      "plan_construction": "scripts/plan_construction.js",
      "build_knowledge_bundle": {
        "entry": "scripts/build_knowledge_bundle.js",
        "before": [
          {
            "service": "fracto-ui",
            "command": "check_feature_catalog"
          }
        ]
      }
    }
  }
}
